<div class="container-xl py-4">
  <h1 class="h3 mb-3"><%= t(".title") %></h1>
  <% filtered = @query.present? || @source_codes.any? %>

  <%= form_with url: foods_path, method: :get, class: "row g-2 mb-3", role: "search",
        data: { controller: "search", action: "submit->search#cancel",
                turbo_frame: "foods", turbo_action: "replace" } do |f| %>
    <div class="col-sm-8 col-lg-5">
      <%= f.search_field :q, value: @query, class: "form-control",
            placeholder: t(".search_placeholder"), aria: { label: t(".search_label") },
            autocomplete: "off", data: { search_target: "query", action: "input->search#search" } %>
    </div>
    <div class="col-auto dropdown">
      <%= render "source_filter", sources: @sources, selected: @source_codes %>
    </div>
    <div class="col-auto d-flex gap-2">
      <%= f.submit t(".search"), name: nil, class: "btn btn-primary", data: { turbo_frame: "_top" } %>
      <%= link_to t(".reset"), foods_path, class: "btn btn-outline-secondary", hidden: !filtered,
            data: { search_target: "reset" } %>
    </div>
  <% end %>

  <%= turbo_frame_tag "foods", target: "_top" do %>
    <% if @foods.any? %>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th scope="col"><%= t(".source_code") %></th>
              <th scope="col"><%= t(".code") %></th>
              <th scope="col"><%= t(".name") %></th>
              <th scope="col"><span class="visually-hidden"><%= t(".actions") %></span></th>
            </tr>
          </thead>
          <tbody>
            <% @foods.each do |food| %>
              <tr>
                <td class="code"><%= food.source_code %></td>
                <td class="code"><%= food.code %></td>
                <td><%= link_to food.name_ukr, food_path(food, list_params) %></td>
                <td class="text-end">
                  <%= link_to edit_food_path(food, list_params), class: "btn btn-outline-secondary btn-sm",
                        title: t(".edit"), aria: { label: t(".edit") } do %>
                    <i class="bi bi-pencil" aria-hidden="true"></i>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%== @pagy.series_nav(:bootstrap) %>
    <% else %>
      <p class="text-body-secondary"><%= t(filtered ? ".not_found" : ".empty") %></p>
    <% end %>
  <% end %>
</div>
