<div class="container-xl py-4">
  <h1 class="h3 mb-3"><%= t(".title") %></h1>

  <% if @foods.any? %>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th scope="col"><%= t(".source_code") %></th>
            <th scope="col"><%= t(".code") %></th>
            <th scope="col"><%= t(".name") %></th>
          </tr>
        </thead>
        <tbody>
          <% @foods.each do |food| %>
            <tr>
              <td class="code"><%= food.source_code %></td>
              <td class="code"><%= food.code %></td>
              <td><%= food.name_ukr %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%== @pagy.series_nav(:bootstrap) %>
  <% else %>
    <p class="text-body-secondary"><%= t(".empty") %></p>
  <% end %>
</div>
