<% content_for :title, "#{@food.name_ukr} · SitoLogic" %>

<div class="container-xl py-4">
  <%= link_to foods_path(list_params), class: "btn btn-outline-secondary btn-sm mb-3" do %>
    <i class="bi bi-arrow-left" aria-hidden="true"></i> <%= t(".back") %>
  <% end %>

  <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
    <h1 class="h3 mb-0"><%= @food.name_ukr %></h1>
    <%= link_to edit_food_path(@food, list_params), class: "btn btn-primary flex-shrink-0" do %>
      <i class="bi bi-pencil" aria-hidden="true"></i> <%= t(".edit") %>
    <% end %>
  </div>

  <div class="row g-3">
    <div class="col-lg-8">
      <div class="card h-100">
        <div class="card-body">
          <% if @food.description_ukr.present? || @food.comment_ukr.present? %>
            <dl class="vstack gap-3 mb-0">
              <% if @food.description_ukr.present? %>
                <div>
                  <dt class="small fw-normal text-body-secondary"><%= t(".description") %></dt>
                  <dd class="text-pre-line mb-0"><%= @food.description_ukr %></dd>
                </div>
              <% end %>
              <% if @food.comment_ukr.present? %>
                <div>
                  <dt class="small fw-normal text-body-secondary"><%= t(".comment") %></dt>
                  <dd class="text-pre-line mb-0"><%= @food.comment_ukr %></dd>
                </div>
              <% end %>
            </dl>
          <% else %>
            <p class="text-body-secondary mb-0"><%= t(".no_details") %></p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card">
        <div class="card-body">
          <dl class="vstack gap-3 mb-0">
            <div>
              <dt class="small fw-normal text-body-secondary"><%= t(".code") %></dt>
              <dd class="mb-0"><span class="badge rounded-pill bg-primary-subtle text-primary-emphasis code"><%= @food.code %></span></dd>
            </div>
            <div>
              <dt class="small fw-normal text-body-secondary"><%= t(".source") %></dt>
              <dd class="d-flex align-items-baseline gap-2 mb-0">
                <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis code flex-shrink-0"><%= @food.source.code %></span>
                <span><%= @food.source.display_name %></span>
              </dd>
            </div>
            <div>
              <dt class="small fw-normal text-body-secondary"><%= t(".group") %></dt>
              <dd class="d-flex align-items-baseline gap-2 mb-0">
                <% if @food.group %>
                  <span class="badge rounded-pill bg-primary-subtle text-primary-emphasis code flex-shrink-0"><%= @food.group.code %></span>
                  <span><%= @food.group.display_name %></span>
                <% else %>
                  <span class="text-body-secondary"><%= t(".no_group") %></span>
                <% end %>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <%= render "nutrients", nutrient_groups: @nutrient_groups %>
</div>
