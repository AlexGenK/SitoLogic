<%= form_with model: menu do |f| %>
  <div class="row g-3">
    <div class="col-sm-4">
      <%= f.label :code, class: "form-label" do %><%= t(".code") %> <span class="required-mark">*</span><% end %>
      <%= f.text_field :code, class: [ "form-control code", { "is-invalid": menu.errors[:code].any? } ] %>
      <%= tag.div(menu.errors[:code].first, class: "invalid-feedback") if menu.errors[:code].any? %>
    </div>
    <div class="col-sm-8">
      <%= f.label :name, class: "form-label" do %><%= t(".name") %> <span class="required-mark">*</span><% end %>
      <%= f.text_field :name, class: [ "form-control", { "is-invalid": menu.errors[:name].any? } ] %>
      <%= tag.div(menu.errors[:name].first, class: "invalid-feedback") if menu.errors[:name].any? %>
    </div>
  </div>

  <h2 class="h6 mt-4"><%= t(".structure") %></h2>
  <div class="row g-3">
    <% Menu::STRUCTURE.each_key do |attribute| %>
      <div class="col-sm-6 col-lg-3">
        <%= f.label attribute, class: "form-label" do %><%= t(".#{attribute}") %> <span class="required-mark">*</span><% end %>
        <%= f.number_field attribute, min: 1, step: 1, class: [ "form-control", { "is-invalid": menu.errors[attribute].any? } ] %>
        <%= tag.div(menu.errors[attribute].first, class: "invalid-feedback") if menu.errors[attribute].any? %>
      </div>
    <% end %>
  </div>
  <div class="form-text"><%= t(".structure_hint") %></div>

  <div class="d-flex justify-content-end gap-2 border-top pt-3 mt-4">
    <%= link_to t(".cancel"), menu.persisted? ? menu_path(menu) : menus_path, class: "btn btn-outline-secondary" %>
    <%= f.submit t(".save"), class: "btn btn-primary", data: { turbo_submits_with: t(".saving") } %>
  </div>
<% end %>
