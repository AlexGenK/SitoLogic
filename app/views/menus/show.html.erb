<% content_for :title, "#{@menu.name} · SitoLogic" %>

<div class="container-xl py-4">

  <%= render 'navs' %>

  <div data-controller="meal-nutrients" data-meal-nutrients-meal-value="1"
       data-meal-nutrients-day-url-value="<%= menu_day_nutrients_path(@menu, @day) %>"
       data-action="meal-variants:change->meal-nutrients#sync">
    <div class="row g-3">
      <div class="col-lg-8 d-flex flex-column gap-3">
        <% 1.upto(@menu.meals_per_day) do |meal| %>
          <%= render "meal", menu: @menu, day: @day, meal:, cells: @cells %>
        <% end %>
      </div>
      <div class="col-lg-4">
        <div class="card menu-nutrients-aside">
          <div class="card-header"><%= t(".nutrients_title") %></div>
          <div class="card-body">
            <% 1.upto(@menu.meals_per_day) do |meal| %>
              <%= render "meal_nutrients", menu: @menu, day: @day, meal:, cells: @cells %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-body">
        <%= turbo_frame_tag "day_nutrients", src: menu_day_nutrients_path(@menu, @day), loading: :lazy,
              data: { meal_nutrients_target: "dayFrame" } do %>
          <p class="text-body-secondary mb-0"><%= t(".loading") %></p>
        <% end %>
      </div>
    </div>
  </div>
</div>
