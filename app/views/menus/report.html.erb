<% content_for :title, "#{@menu.name} · SitoLogic" %>

<div class="container-xl py-4">

  <%= render 'navs' %>

  <div class="card">
    <div class="card-header d-flex align-items-center gap-2">
      <h2 class="h5 mb-0"><%= t(".title") %></h2>
      <%= link_to report_menu_path(@menu, format: :pdf), class: "btn btn-outline-secondary btn-sm ms-auto", data: { turbo: false } do %>
        <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> <%= t(".download_pdf") %>
      <% end %>
    </div>
    <div class="table-responsive">
      <table class="table align-middle mb-0 report-table">
        <tbody>
          <% @rows.each do |key, value| %>
            <tr>
              <th scope="row"><%= t(".#{key}") %></th>
              <%= tag.td value, class: { code: key == :code, "text-nowrap": key.in?(%i[total_amount daily_amount]) } %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card mt-4">
    <div class="card-header">
      <h2 class="h5 mb-0"><%= t(".nutrients_title") %></h2>
    </div>
    <% if @nutrient_groups.empty? %>
      <div class="card-body">
        <p class="text-body-secondary mb-0"><%= t(".no_nutrients") %></p>
      </div>
    <% else %>
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead>
            <tr>
              <th scope="col"><%= t("foods.nutrients.nutrient") %></th>
              <th scope="col"><%= t("foods.nutrients.unit") %></th>
              <th scope="col" class="num"><%= t(".nutrients_total") %></th>
              <th scope="col" class="num"><%= t(".nutrients_per_day") %></th>
              <th scope="col" class="num"><%= t(".nutrients_per_meal") %></th>
              <th scope="col" class="num"><%= t(".nutrients_per_dish") %></th>
            </tr>
          </thead>
          <% @nutrient_groups.each do |_, rows| %>
            <tbody>
              <tr class="nutrient-group-header">
                <th scope="colgroup" colspan="6"><%= rows.first.first.group_ukr || t("foods.nutrients.other_group") %></th>
              </tr>
              <% rows.each do |nutrient, *amounts| %>
                <tr>
                  <td><%= nutrient.display_name %></td>
                  <td class="text-body-secondary"><%= nutrient.unit_ukr %></td>
                  <% amounts.each_with_index do |amount, index| %>
                    <%= tag.td nutrient_sum(amount), class: [ "num", { "fw-semibold": index.zero? } ] %>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          <% end %>
        </table>
      </div>
    <% end %>
  </div>

  <div class="card mt-4">
    <div class="card-header">
      <h2 class="h5 mb-0"><%= t(".foods_title") %></h2>
    </div>
    <% if @foods.empty? %>
      <div class="card-body">
        <p class="text-body-secondary mb-0"><%= t(".no_foods") %></p>
      </div>
    <% else %>
      <div class="table-responsive">
        <table id="menu_foods" class="table table-sm table-hover align-middle mb-0">
          <thead>
            <tr>
              <th scope="col"><%= t(".foods_source") %></th>
              <th scope="col"><%= t(".foods_code") %></th>
              <th scope="col" class="num"><%= t(".foods_amount") %></th>
              <th scope="col" class="num"><%= t(".foods_share") %></th>
              <th scope="col"><%= t(".foods_name") %></th>
            </tr>
          </thead>
          <tbody>
            <% @foods.each do |food, amount, share| %>
              <tr>
                <td class="code"><%= food.source_code %></td>
                <td class="code"><%= food.code %></td>
                <td class="num"><%= grams(amount) %></td>
                <td class="num"><%= percent_share(share) %></td>
                <td><%= link_to food.name_ukr, food_path(food) %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot>
            <tr class="fw-semibold">
              <th scope="row" colspan="2"><%= t(".foods_total") %></th>
              <td class="num"><%= grams(@menu.total_amount) %></td>
              <td class="num"><%= percent_share(100) %></td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>
    <% end %>
  </div>

</div>
