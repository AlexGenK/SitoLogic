<% content_for :title, "#{@menu.name} · SitoLogic" %>

<div class="container-xl py-4">

  <%= render 'navs' %>

  <div class="card">
    <div class="card-header">
      <h2 class="h5 mb-0"><%= t(".title") %></h2>
    </div>
    <div class="table-responsive">
      <table class="table align-middle mb-0 report-table">
        <tbody>
          <tr>
            <th scope="row"><%= t(".code") %></th>
            <td class="code"><%= @menu.code %></td>
          </tr>
          <tr>
            <th scope="row"><%= t(".name") %></th>
            <td><%= @menu.name %></td>
          </tr>
          <tr>
            <th scope="row"><%= t(".items_count") %></th>
            <td><%= @items_count %></td>
          </tr>
          <tr>
            <th scope="row"><%= t(".total_amount") %></th>
            <td class="text-nowrap"><%= t(".grams", value: grams(@total_amount)) %></td>
          </tr>
          <tr>
            <th scope="row"><%= t(".daily_amount") %></th>
            <td class="text-nowrap"><%= t(".grams", value: grams(@total_amount / @menu.days_count)) %></td>
          </tr>
          <tr>
            <th scope="row"><%= t(".structure") %></th>
            <td>
              <%= safe_join([
                    t(".days", count: @menu.days_count),
                    t(".meals", count: @menu.meals_per_day),
                    t(".dishes", count: @menu.items_per_meal),
                    t(".variants", count: @menu.variants_per_item)
                  ], " · ") %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

</div>
